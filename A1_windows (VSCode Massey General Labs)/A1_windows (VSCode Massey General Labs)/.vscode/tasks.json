            "args": [
                "batch_run",
                "all"
            ],
            "dependsOn": "make",
            "problemMatcher": []
        },
        {
            "label": "run astar manhattan",
            "type": "shell",
            "command": "./search.out",
            "args": [
                "single_run",
                "astar_explist_manhattan",
                "120483765",
                "123456780"
            ],
            "dependsOn": "make",
            "problemMatcher": []
        }
    ]
}
